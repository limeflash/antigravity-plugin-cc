# Enforce LF line endings for all text, on every platform.
#
# Critical for the launcher: a POSIX shell chokes on CRLF line endings
# ("$'\r': command not found"), so a Windows checkout with
# core.autocrlf=true would produce a launcher that breaks under WSL or Git
# Bash. Forcing eol=lf keeps it runnable everywhere. (PowerShell is fine
# with LF.)
* text=auto eol=lf

# Be explicit for the script / source / config types.
*.sh    text eol=lf
*.ps1   text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
plugins/agy/bin/agy-plugin   text eol=lf
plugins/agy/bin/VERSION      text eol=lf
plugins/agy/bin/SHA256SUMS   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Known binaries: never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
